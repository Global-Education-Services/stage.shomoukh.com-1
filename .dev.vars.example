# Copy to .dev.vars for `wrangler dev` (never commit the real file).
# In production set these with: npx wrangler secret put RESEND_API_KEY
#                               npx wrangler secret put TURNSTILE_SECRET_KEY
RESEND_API_KEY=re_replace_me
TURNSTILE_SECRET_KEY=replace_me
# Cloudflare's always-pass test keys, handy for local development:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# FORM_ALLOWED_ORIGIN=http://localhost:8787
