{
  "name": "gps-website-clone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5174",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "chatbot:build": "node scripts/build-chatbot.mjs",
    "prebuild": "npm run chatbot:build && npm run i18n:build",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "chatbot:word-guards": "node scripts/build-chatbot-word-guards.mjs",
    "chatbot:evaluate": "node scripts/evaluate-chatbot.mjs",
    "chatbot:generate-tests": "node scripts/generate-10k-questions.mjs",
    "chatbot:test-10k": "node scripts/evaluate-10k.mjs",
    "chatbot:coverage": "node scripts/chatbot-coverage.mjs",
    "test:site": "node tests/site-audit.mjs",
    "audit:links": "node scripts/audit-public-links.mjs",
    "i18n:build": "node scripts/build-arabic.mjs",
    "predev": "npm run i18n:build"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "vite": "^6.4.5",
    "wrangler": "^4.152.0",
    "postcss": "^8.5.6"
  }
}
